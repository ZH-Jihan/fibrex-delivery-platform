  @@index([familyId], map: "refresh_token_family_idx")
  @@map("refresh_token")
  @@schema("iam")
}

/// Login history; monthly partitions live in the `partitions` schema (not managed by Prisma).
model LoginEvent {
  id         String   @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(6)
  userId     String?  @map("user_id") @db.Uuid
  identifier String
  method     String
  result     String
  ip         String?  @db.Inet
  device     String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?  @map("created_by") @db.Uuid

  @@id([id, at])
  @@index([userId, at(sort: Desc)], map: "login_event_user_idx")
  @@map("login_event")
  @@schema("iam")
}

model PasswordResetToken {
  id           String    @id @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid
  version      Int       @default(1)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason")

  user UserAccount @relation(fields: [tenantId, userId], references: [tenantId, id], map: "password_reset_token_user_fk", onDelete: NoAction, onUpdate: NoAction)

  @@unique([tokenHash], map: "password_reset_token_hash_uq")
  @@map("password_reset_token")
  @@schema("iam")
}

model ApiClient {
