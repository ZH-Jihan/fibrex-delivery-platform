  @@unique([tenantId, id], map: "user_account_tenant_id_uq")
  @@unique([tenantId, username], map: "user_account_username_uq", where: { deletedAt: null })
  @@unique([tenantId, email], map: "user_account_email_uq", where: raw("deleted_at IS NULL AND email IS NOT NULL"))
  @@unique([tenantId, phone], map: "user_account_phone_uq", where: raw("deleted_at IS NULL AND phone IS NOT NULL"))
  @@index([partyId], map: "user_account_party_idx")
  @@map("user_account")
  @@schema("iam")
}

