  updatedBy               String?                  @map("updated_by") @db.Uuid
  version                 Int                      @default(1)
  deletedAt               DateTime?                @map("deleted_at") @db.Timestamptz(6)
  deletedBy               String?                  @map("deleted_by") @db.Uuid
  deleteReason            String?                  @map("delete_reason")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  credentials            Credential[]
  mfaFactors             MfaFactor[]
  recoveryCodes          MfaRecoveryCode[]
  otpChallenges          OtpChallenge[]
  memberships            CompanyMembership[]
  permissionOverrides    UserPermissionOverride[]
  impersonationsActor    Impersonation[]          @relation("ImpersonationActor")
  impersonationsTarget   Impersonation[]          @relation("ImpersonationTarget")
  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  workflowsStarted       WorkflowInstance[]       @relation("WorkflowInstanceStarter")
  workflowTasks          WorkflowTask[]           @relation("WorkflowTaskAssignee")
