// Schema `cfg`: configurable engines (PLAN 3.7). Row 2.3 adds the lookups, row 2.4 the entity definitions.

// Row 2.13: reports are declared in code and synced here (a global catalogue); a saved report is a person's filters.
model ReportDefinition {
  id            String   @id @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  key           String   @unique
  moduleKey     String   @map("module_key")
  label         String
  description   String   @default("")
  source        String   @default("code")
  config        Json     @default("{}")
  permissionKey String   @map("permission_key")
  isSystem      Boolean  @default(true) @map("is_system")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?  @map("created_by") @db.Uuid
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?  @map("updated_by") @db.Uuid
  version       Int      @default(1)

  savedReports SavedReport[]

  @@map("report_definition")
  @@schema("cfg")
}

model SavedReport {
  id           String    @id @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  reportKey    String    @map("report_key")
  ownerUserId  String    @map("owner_user_id") @db.Uuid
  name         String
  filters      Json      @default("{}")
  columns      Json      @default("[]")
  sharedWith   Json      @default("[]") @map("shared_with")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid
  version      Int       @default(1)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], map: "saved_report_tenant_fk", onDelete: NoAction, onUpdate: NoAction)
  definition ReportDefinition @relation(fields: [reportKey], references: [key], map: "saved_report_definition_fk", onDelete: NoAction, onUpdate: NoAction)
  schedules  ReportSchedule[]

  @@unique([tenantId, ownerUserId, reportKey, name], map: "saved_report_name_uq", where: { deletedAt: null })
  @@index([tenantId, reportKey], map: "saved_report_owner_idx", where: { deletedAt: null })
  @@map("saved_report")
  @@schema("cfg")
}

model LookupType {
  id             String    @id @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  key            String
  name           String
  isSystem       Boolean   @default(false) @map("is_system")
  allowHierarchy Boolean   @default(false) @map("allow_hierarchy")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(1)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?   @map("deleted_by") @db.Uuid
  deleteReason   String?   @map("delete_reason")

  tenant Tenant        @relation(fields: [tenantId], references: [id], map: "lookup_type_tenant_fk", onDelete: NoAction, onUpdate: NoAction)
  values LookupValue[]
  fieldDefinitions FieldDefinition[]
  stateTransitions StateTransition[]

  @@unique([tenantId, id], map: "lookup_type_tenant_id_uq")
  @@unique([tenantId, key], map: "lookup_type_key_uq", where: { deletedAt: null })
  @@map("lookup_type")
  @@schema("cfg")
}

model LookupValue {
  id           String    @id @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  lookupTypeId String    @map("lookup_type_id") @db.Uuid
  code         String
  labels       Json
  parentId     String?   @map("parent_id") @db.Uuid
  sortOrder    Int       @default(0) @map("sort_order")
  active       Boolean   @default(true)
  meta         Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid
  version      Int       @default(1)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason")

  type     LookupType    @relation(fields: [tenantId, lookupTypeId], references: [tenantId, id], map: "lookup_value_type_fk", onDelete: NoAction, onUpdate: NoAction)
  parent   LookupValue?  @relation("LookupValueTree", fields: [tenantId, parentId], references: [tenantId, id], map: "lookup_value_parent_fk", onDelete: NoAction, onUpdate: NoAction)
  children LookupValue[] @relation("LookupValueTree")
  stateHistory StateHistory[]

  @@unique([tenantId, id], map: "lookup_value_tenant_id_uq")
  @@unique([lookupTypeId, code], map: "lookup_value_code_uq", where: { deletedAt: null })
  @@index([lookupTypeId, sortOrder], map: "lookup_value_list_idx", where: raw("deleted_at IS NULL"))
  @@map("lookup_value")
  @@schema("cfg")
}

// Row 2.4: record types (entity definitions), their fields and the published versions.
model EntityDefinition {
  id                    String    @id @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  key                   String
  name                  Json
  kind                  String    @default("custom")
  jsonSchema            Json      @default("{}") @map("json_schema")
  listConfig            Json      @default("{}") @map("list_config")
  formLayout            Json      @default("{}") @map("form_layout")
  detailLayout          Json      @default("{}") @map("detail_layout")
  numberingKey          String?   @map("numbering_key")
  stateMachineId        String?   @map("state_machine_id") @db.Uuid
  permissionModuleKey   String    @map("permission_module_key")
  status                String    @default("draft")
  publishedVersion      Int       @default(0) @map("published_version")
  publishedAt           DateTime? @map("published_at") @db.Timestamptz(6)
  hasUnpublishedChanges Boolean   @default(false) @map("has_unpublished_changes")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy             String?   @map("created_by") @db.Uuid
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy             String?   @map("updated_by") @db.Uuid
  version               Int       @default(1)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy             String?   @map("deleted_by") @db.Uuid
  deleteReason          String?   @map("delete_reason")

  tenant   Tenant                    @relation(fields: [tenantId], references: [id], map: "entity_definition_tenant_fk", onDelete: NoAction, onUpdate: NoAction)
  fields   FieldDefinition[]
  versions EntityDefinitionVersion[]
  records  CustomRecord[]

  @@unique([tenantId, id], map: "entity_definition_tenant_id_uq")
  @@unique([tenantId, key], map: "entity_definition_key_uq", where: { deletedAt: null })
  @@map("entity_definition")
  @@schema("cfg")
}

model FieldDefinition {
  id                 String    @id @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  entityDefinitionId String    @map("entity_definition_id") @db.Uuid
