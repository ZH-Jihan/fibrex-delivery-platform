// platform: tenancy, companies, branches, zones, settings, numbering, currencies.
// Table definitions and comments: prisma/migrations/20261113000100_platform_iam.

model Currency {
  id         String   @id @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  code       String   @unique @db.Char(3)
  name       String
  minorUnits Int      @default(2) @map("minor_units") @db.SmallInt
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?  @map("created_by") @db.Uuid
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?  @map("updated_by") @db.Uuid
  version    Int      @default(1)

  companies Company[]

  @@map("currency")
  @@schema("platform")
}

model Tenant {
  id                  String    @id @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  name                String
  slug                String
  status              String    @default("active")
  dataResidencyRegion String?   @map("data_residency_region")
  onboardedAt         DateTime? @map("onboarded_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?   @map("created_by") @db.Uuid
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?   @map("updated_by") @db.Uuid
  version             Int       @default(1)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy           String?   @map("deleted_by") @db.Uuid
  deleteReason        String?   @map("delete_reason")

  subscriptions TenantSubscription[]
  usageCounters UsageCounter[]
  companies     Company[]
  settings      Setting[]
  lookupTypes   LookupType[]
  entityDefinitions EntityDefinition[]
  users         UserAccount[]
  notificationRules NotificationRule[]
  otpChallenges OtpChallenge[]
  roles         Role[]
  ipAllowlist   IpAllowlist[]
  ssoProviders  SsoProvider[]
  auditSeals    AuditSeal[]
  exportLogs    ExportLog[]

  @@unique([slug], map: "tenant_slug_uq", where: { deletedAt: null })
  @@map("tenant")
  @@schema("platform")
}

model SubscriptionPlan {
  id        String   @id @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  code      String   @unique
  name      String
  limits    Json     @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)

  subscriptions TenantSubscription[]

  @@map("subscription_plan")
  @@schema("platform")
}

model TenantSubscription {
  id           String    @id @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  planId       String    @map("plan_id") @db.Uuid
  validFrom    DateTime  @map("valid_from") @db.Date
  validTo      DateTime? @map("valid_to") @db.Date
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid
  version      Int       @default(1)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("tenant_subscription")
  @@schema("platform")
}

model UsageCounter {
  id           String    @id @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  metric       String
  period       DateTime  @db.Date
  value        BigInt    @default(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid
  version      Int       @default(1)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, metric, period], map: "usage_counter_uq", where: { deletedAt: null })
  @@map("usage_counter")
  @@schema("platform")
}

model Company {
  id                   String    @id @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  legalName            String    @map("legal_name")
  tradeName            String?   @map("trade_name")
  countryCode          String    @map("country_code") @db.Char(2)
  baseCurrency         String    @map("base_currency") @db.Char(3)
  timeZone             String    @default("Asia/Qatar") @map("time_zone")
  workingWeek          Json      @default("[\"sun\", \"mon\", \"tue\", \"wed\", \"thu\"]") @map("working_week")
  fiscalYearStartMonth Int       @default(1) @map("fiscal_year_start_month") @db.SmallInt
  logoFileId           String?   @map("logo_file_id") @db.Uuid
  letterhead           Json      @default("{}")
  status               String    @default("active")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy            String?   @map("created_by") @db.Uuid
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy            String?   @map("updated_by") @db.Uuid
  version              Int       @default(1)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy            String?   @map("deleted_by") @db.Uuid
  deleteReason         String?   @map("delete_reason")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currency Currency @relation(fields: [baseCurrency], references: [code], onDelete: NoAction, onUpdate: NoAction)

  branches            Branch[]
  orgUnits            OrgUnit[]
  modules             CompanyModule[]
  settings            Setting[]
  numberSequences     NumberSequence[]
  linksFrom           InterCompanyLink[]        @relation("InterCompanyFrom")
  linksTo             InterCompanyLink[]        @relation("InterCompanyTo")
  memberships         CompanyMembership[]
  permissionOverrides UserPermissionOverride[]
  dataScopes          DataScope[]
  sessions            Session[]
  apiClients          ApiClient[]
  apiKeys             ApiKey[]
  fileObjects         FileObject[]
  fileAttachments     FileAttachment[]
  rawInputs           RawInput[]
  parties             Party[]
  partyRoles          PartyRole[]
  partyIdentifiers    PartyIdentifier[]
  partyContacts       PartyContact[]
  partyAddresses      PartyAddress[]
  partyRelationships  PartyRelationship[]
  partyBankAccounts   PartyBankAccount[]
  partyDuplicates     PartyDuplicateCandidate[]
  partyMerges         PartyMerge[]

  @@unique([tenantId, id], map: "company_tenant_id_uq")
  @@map("company")
  @@schema("platform")
}

model Branch {
  id           String    @id @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  code         String
  name         String
  address      String?
  isHeadOffice Boolean   @default(false) @map("is_head_office")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid
  version      Int       @default(1)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason")

  company  Company   @relation(fields: [tenantId, companyId], references: [tenantId, id], map: "branch_company_fk", onDelete: NoAction, onUpdate: NoAction)
  orgUnits OrgUnit[]

  @@unique([companyId, id], map: "branch_company_id_uq")
  @@unique([companyId, code], map: "branch_code_uq", where: { deletedAt: null })
  @@map("branch")
  @@schema("platform")
}

model OrgUnit {
  id           String    @id @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  branchId     String?   @map("branch_id") @db.Uuid
  kind         String
  code         String
  name         String
  parentId     String?   @map("parent_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid
  version      Int       @default(1)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason")

  company  Company   @relation(fields: [tenantId, companyId], references: [tenantId, id], map: "org_unit_company_fk", onDelete: NoAction, onUpdate: NoAction)
  branch   Branch?   @relation(fields: [companyId, branchId], references: [companyId, id], map: "org_unit_branch_fk", onDelete: NoAction, onUpdate: NoAction)
  parent   OrgUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children OrgUnit[] @relation("OrgUnitTree")

  @@unique([companyId, kind, code], map: "org_unit_code_uq", where: { deletedAt: null })
  @@index([parentId], map: "org_unit_parent_idx")
  @@map("org_unit")
  @@schema("platform")
}

