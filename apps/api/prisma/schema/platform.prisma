model Setting {
  id           String    @id @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  companyId    String?   @map("company_id") @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  scope        String
  key          String
  value        Json
  validFrom    DateTime  @default(dbgenerated("CURRENT_DATE")) @map("valid_from") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid
  version      Int       @default(1)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company Company? @relation(fields: [tenantId, companyId], references: [tenantId, id], map: "setting_company_fk", onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, key, validFrom], map: "setting_tenant_uq", where: raw("scope = 'tenant'::text AND deleted_at IS NULL"))
  @@unique([companyId, key, validFrom], map: "setting_company_uq", where: raw("scope = 'company'::text AND deleted_at IS NULL"))
  @@unique([userId, key, validFrom], map: "setting_user_uq", where: raw("scope = 'user'::text AND deleted_at IS NULL"))
  @@map("setting")
  @@schema("platform")
}

model NumberSequence {
  id           String    @id @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  key          String
  prefix       String    @default("")
  padding      Int       @default(4) @db.SmallInt
  nextValue    BigInt    @default(1) @map("next_value")
  resetPolicy  String    @default("never") @map("reset_policy")
  format       String    @default("{prefix}{number}")
  lastResetAt  DateTime? @map("last_reset_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid
  version      Int       @default(1)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason")

  company Company @relation(fields: [tenantId, companyId], references: [tenantId, id], map: "number_sequence_company_fk", onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, key], map: "number_sequence_key_uq", where: { deletedAt: null })
  @@map("number_sequence")
  @@schema("platform")
}

model InterCompanyLink {
  id                  String    @id @default(dbgenerated("app.uuid_generate_v7()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  fromCompanyId       String    @map("from_company_id") @db.Uuid
  toCompanyId         String    @map("to_company_id") @db.Uuid
  receivableAccountId String?   @map("receivable_account_id") @db.Uuid
  payableAccountId    String?   @map("payable_account_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?   @map("created_by") @db.Uuid
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?   @map("updated_by") @db.Uuid
  version             Int       @default(1)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy           String?   @map("deleted_by") @db.Uuid
  deleteReason        String?   @map("delete_reason")

  fromCompany Company @relation("InterCompanyFrom", fields: [tenantId, fromCompanyId], references: [tenantId, id], map: "inter_company_link_from_fk", onDelete: NoAction, onUpdate: NoAction)
  toCompany   Company @relation("InterCompanyTo", fields: [tenantId, toCompanyId], references: [tenantId, id], map: "inter_company_link_to_fk", onDelete: NoAction, onUpdate: NoAction)

  @@unique([fromCompanyId, toCompanyId], map: "inter_company_link_uq", where: { deletedAt: null })
  @@map("inter_company_link")
  @@schema("platform")
}
