{
  "name": "@fibrex/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fibrex API and background worker (Express, Prisma, BullMQ)",
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentation.ts src/main.ts",
    "typecheck": "prisma generate --no-hints && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "tsx src/seed/seed-cli.ts",
    "db:seed:e2e": "tsx src/seed/e2e-seed-cli.ts",
    "db:e2e": "tsx src/seed/e2e-db-cli.ts",
    "e2e:serve": "tsx src/seed/e2e-serve-cli.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "@fibrex/formula": "workspace:*",
    "@fibrex/shared": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation-express": "0.72.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/semantic-conventions": "1.44.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^6.7.6",
    "cors": "2.8.6",
    "exceljs": "^4.4.0",
    "express": "5.3.0",
    "handlebars": "^4.7.10",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nodemailer": "^10.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "playwright-core": "1.65.0",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fibrex/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "socket.io-client": "^4.8.4",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
