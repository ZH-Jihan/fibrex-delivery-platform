{
  "name": "@fibrex/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fibrex web app (React 18, Vite): design system, shell and sign-in screens",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
