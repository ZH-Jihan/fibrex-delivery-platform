# Fibrex local development settings.
# Copy to .env and change the passwords. Never commit .env (it is git-ignored).
# Values here are development defaults only; staging and production use a secret store.

# --- PostgreSQL 16 -------------------------------------------------------------
# Bootstrap superuser: used only by the container to create the roles below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-dev-superuser
POSTGRES_DB=fibrex
POSTGRES_PORT=5433

# Owner role: runs migrations and owns every table. Never used by the running app.
FIBREX_OWNER_PASSWORD=change-me-dev-owner
# App role: NOBYPASSRLS, no DELETE grant. The API and worker connect as this role.
FIBREX_APP_PASSWORD=change-me-dev-app
# BI role: read-only on the reporting schema (SPEC 2.12, 5.19).
FIBREX_BI_PASSWORD=change-me-dev-bi

DATABASE_URL_OWNER=postgresql://fibrex_owner:change-me-dev-owner@localhost:5433/fibrex
DATABASE_URL=postgresql://fibrex_app:change-me-dev-app@localhost:5433/fibrex

# --- Redis (BullMQ queues, Socket.IO adapter, rate limits) ---------------------
REDIS_PASSWORD=change-me-dev-redis
REDIS_PORT=6379
REDIS_URL=redis://:change-me-dev-redis@localhost:6379/0

# --- S3-compatible object storage (SeaweedFS locally) --------------------------
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=fibrex-dev
S3_ACCESS_KEY=fibrex-dev-access
S3_SECRET_KEY=change-me-dev-s3-secret
S3_FORCE_PATH_STYLE=true
S3_PORT=8333

# --- Email (Mailpit catches every message locally; UI on http://localhost:8025) -
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Fibrex <no-reply@fibrex.local>"
MAILPIT_UI_PORT=8025

# --- API server ------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
# 1 = human-readable logs in the terminal (development only)
LOG_PRETTY=1
# Exact browser origins allowed to call the API (comma-separated, no wildcards)
CORS_ORIGINS=http://localhost:5173
# Reverse proxies in front of the API (0 locally)
TRUST_PROXY_HOPS=0
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANONYMOUS=120
RATE_LIMIT_AUTHENTICATED=600
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_SECONDS=60
# OpenTelemetry: leave empty to disable tracing; set to an OTLP/HTTP collector to enable
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=fibrex-api

# --- Authentication (required; the API refuses to start without them) ---
# Signs access tokens. At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_TOKEN_SECRET=change-me-generate-a-random-value-of-32-plus-chars
# Encrypts secrets stored in the database (TOTP seeds). Exactly 32 random bytes in base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# Optional (defaults shown): seconds between two codes or reset links for one person,
# the name shown in authenticator apps, and the web app address used in message links.
AUTH_OTP_RESEND_SECONDS=60
AUTH_TOTP_ISSUER=Fibrex
WEB_BASE_URL=http://localhost:5173

# --- Google Sheets reader (read-only; steps in docs/GOOGLE_SETUP.md) ----------------
# OAuth client "Web application" from Google Cloud. Never commit the real values.
# Redirect URI empty = WEB_BASE_URL + /settings/google-connection/callback; it must be
# listed exactly as an "Authorised redirect URI" on the OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- Seed (pnpm db:seed) ---------------------------------------------------------
# Super Admin password for the demo tenant. Leave empty: the seed generates one and writes it here.
SEED_SUPERADMIN_PASSWORD=
